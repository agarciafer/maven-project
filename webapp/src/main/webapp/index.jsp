<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Curso DevOps CNTG</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #0f172a, #1e3a8a, #06b6d4);
            color: white;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .card {
            background: rgba(255, 255, 255, 0.12);
            padding: 45px;
            border-radius: 25px;
            text-align: center;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
            backdrop-filter: blur(10px);
        }

        h1 {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .version {
            display: inline-block;
            background: #22c55e;
            padding: 10px 22px;
            border-radius: 20px;
            font-weight: bold;
            margin: 15px 0;
        }

        .footer {
            margin-top: 25px;
            font-size: 18px;
        }
    </style>
</head>

<body>
    <div class="card">
        <h1>🚀 Hello, World</h1>
        <div class="version">Versión v4</div>
        <h2>Lunes 15-06-2026</h2>
        <p class="footer">Curso DevOps CNTG</p>
    </div>
</body>
</html>
